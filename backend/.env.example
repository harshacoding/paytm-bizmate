# Local synthetic session only. Never accept merchant identity from an LLM.
BIZMATE_DEMO_MERCHANT_ID=merchant_demo
BIZMATE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Relative paths are resolved from backend/, regardless of the startup directory.
BIZMATE_DATABASE_PATH=.data/bizmate.sqlite3
# Synthetic demo controls. Disable to reject reset, failure and time/consent changes.
BIZMATE_DEMO_CONTROLS_ENABLED=true
# No model key is needed to run this scaffold. Add a provider in BM-07.
