# Local synthetic session only. Never accept merchant identity from an LLM.
BIZMATE_DEMO_MERCHANT_ID=merchant_demo
BIZMATE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Relative paths are resolved from backend/, regardless of the startup directory.
BIZMATE_DATABASE_PATH=.data/bizmate.sqlite3
# Synthetic demo controls. Disable to reject reset, failure and time/consent changes.
BIZMATE_DEMO_CONTROLS_ENABLED=true
# Offline deterministic demo parser supports documented en/te/hi examples without a model key.
# Use sarvam or openai for live structured extraction. Server-only credentials.
BIZMATE_PLANNER_MODE=demo
# Leaving model unset selects sarvam-105b for sarvam, gpt-4o-mini for openai.
# For Sarvam, set mode=sarvam and uncomment these settings:
# BIZMATE_PLANNER_MODEL=sarvam-105b
# BIZMATE_SARVAM_API_KEY=your-server-api-key
# OpenAI alternative:
# BIZMATE_PLANNER_MODEL=gpt-4o-mini
# BIZMATE_OPENAI_API_KEY=your-server-api-key
# Optional live dictation. Set locally in backend/.env and keep the value private.
BIZMATE_ELEVENLABS_API_KEY=
